# OptiPDF Studio — Environment Configuration
APP_NAME="OptiPDF Studio — Precision PDF Size Reducer"
ENVIRONMENT=production
API_V1_PREFIX=/api/v1

# Upload & Document Limits
MAX_UPLOAD_SIZE_MB=100
MAX_PAGE_COUNT=1000
MAX_BATCH_FILES=20

# Worker & Resource Safety
MAX_CONCURRENT_JOBS=4
COMPRESSION_TIMEOUT_SECONDS=120
GS_TIMEOUT_SECONDS=45
MAX_TARGET_ITERATIONS=6

# Ephemeral Privacy & Retention
STORAGE_DIR=/tmp/optipdf_ephemeral_store
FILE_RETENTION_MINUTES=30
CLEANUP_INTERVAL_SECONDS=120

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=*
